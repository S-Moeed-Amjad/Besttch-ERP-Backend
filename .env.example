# Server
NODE_ENV=development
PORT=4000

# PostgreSQL connection string used by Prisma.
# Local dev example (adjust user/password/db name to match your local Postgres):
DATABASE_URL="postgresql://postgres:password@localhost:5432/besttech_erp?schema=public"

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Comma-separated list of origins allowed to call this API with credentials.
CORS_ORIGIN=http://localhost:5173

# Cookie name used to store the auth token.
COOKIE_NAME=besttech_token
